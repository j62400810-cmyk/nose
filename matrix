-- 2. OBTENER JUGADOR MÁS CERCANO
local function getSoruClosestPlayer(overrideMaxDist)
    local myHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end

    local searchDist = overrideMaxDist or _G.soruMaxDist or 1000

    if _G.SelectedSoruTarget ~= "Nearest" and _G.SelectedSoruTarget ~= nil and _G.SelectedSoruTarget ~= "" then
        local targetP = Players:FindFirstChild(_G.SelectedSoruTarget)
        if targetP and targetP ~= player and targetP.Character and targetP.Character:FindFirstChild("HumanoidRootPart") then
            local hum = targetP.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                return targetP.Character
            end
        end
    end

    local closest = nil
    local closestDist = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local dist = (p.Character.HumanoidRootPart.Position - myHRP.Position).Magnitude
                if dist < closestDist and dist <= searchDist then
                    closestDist = dist
                    closest = p.Character
                end
            end
        end
    end
    return closest
end

-- 3. SORU EXTENDIDO
local function performExtendedSoru(targetPos)
    if not targetPos then return end

    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local currentPos = hrp.Position
    local fullDist = (targetPos - currentPos).Magnitude
    
    if fullDist <= 950 then
        pcall(function()
            if commF then
                commF:InvokeServer("Flashstep", targetPos)
            else
                hrp.CFrame = CFrame.new(targetPos)
            end
        end)
        return
    end

    local steps = math.ceil(fullDist / 900)
    local dir = (targetPos - currentPos).Unit

    for i = 1, steps do
        local nextDist = math.min(i * 900, fullDist)
        local nextPos = currentPos + (dir * nextDist)

        pcall(function()
            if commF then
                commF:InvokeServer("Flashstep", nextPos)
            else
                hrp.CFrame = CFrame.new(nextPos)
            end
        end)

        task.wait(0.015)
    end
end

-- 4. SORU AIMBOT - BUCLE PARA MÓVIL
local function SoruAimbotLoop()
    if not _G.SoruAimbotEnabled then return end
    
    local target = getSoruClosestPlayer(_G.soruMaxDist)
    if not target then return end
    
    local hrp = target:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    
    local dist = (hrp.Position - myHrp.Position).Magnitude
    if dist <= _G.soruMaxDist then
        performExtendedSoru(hrp.Position)
    end
end

task.spawn(function()
    while true do
        task.wait(0.15)
        SoruAimbotLoop()
    end
end)

-- 5. SORU AIMBOT - HOOK DE MOUSE PARA PC
do
    local SoruMouse = player:GetMouse()
    local ok, mt = pcall(getrawmetatable, game)

    if ok and mt then
        local oldIndex = mt.__index
        local oldNamecall = mt.__namecall

        local function isCaller()
            if checkcaller then
                return checkcaller()
            end
            return false
        end

        local success = pcall(setreadonly, mt, false)

        if success then
            mt.__index = function(self, key)
                if not isCaller()
                    and self == SoruMouse
                    and (key == "Hit" or key == "Target")
                    and _G.SoruAimbotEnabled then

                    local targetChar = getSoruClosestPlayer(_G.soruMaxDist)
                    local eHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

                    if eHRP then
                        local myHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                        if myHRP then
                            local dist = (myHRP.Position - eHRP.Position).Magnitude
                            if dist <= (_G.soruMaxDist or 1000) then
                                if dist > 950 then
                                    task.spawn(function()
                                        performExtendedSoru(eHRP.Position)
                                    end)
                                end

                                if key == "Hit" then
                                    return CFrame.new(eHRP.Position)
                                end
                                if key == "Target" then
                                    return eHRP
                                end
                            end
                        end
                    end
                end

                return oldIndex(self, key)
            end

            mt.__namecall = function(self, ...)
                return oldNamecall(self, ...)
            end

            pcall(setreadonly, mt, true)
        end
    end
end

-- 6. PORTAL SORU
local FLASH_NAMES = {
    "FlashStepRegular",
    "FlashStepDraco",
    "FlashStep",
    "Flashstep",
    "Soru"
}

local FLASH_IDS = {
    "17555632156",
    "18461649274",
    "616006778",
    "616010882",
    "5403485593",
    "5403491911"
}

local function isFlashstep(track)
    for _, name in ipairs(FLASH_NAMES) do
        if string.find(string.lower(track.Name), string.lower(name)) then
            return true
        end
    end

    local id = track.Animation and track.Animation.AnimationId:match("%d+") or ""
    for _, flashId in ipairs(FLASH_IDS) do
        if id == flashId then
            return true
        end
    end

    return false
end

local function isHoldingPortalFruit()
    local char = player.Character
    if not char then return false end

    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local name = string.lower(tool.Name)
        if string.find(name, "portal") or string.find(name, "door") then
            return true
        end
    end
    return false
end

local function equipPortalFruit()
    local char = player.Character
    if not char then return nil end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end

    local tool = char:FindFirstChild("Portal-Portal") 
        or char:FindFirstChild("Portal Fruit") 
        or char:FindFirstChild("Portal") 
        or char:FindFirstChild("Door")

    if not tool then
        local bp = player:FindFirstChild("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                local name = string.lower(t.Name)
                if string.find(name, "portal") or string.find(name, "door") then
                    hum:EquipTool(t)
                    tool = t
                    task.wait(0.1)
                    break
                end
            end
        end
    end

    return tool
end

local function doPortalCombo()
    if not isHoldingPortalFruit() then
        equipPortalFruit()
        task.wait(0.08)
    end

    if not isHoldingPortalFruit() then
        return
    end

    local function pressKey(keyCode)
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end

    pressKey(Enum.KeyCode.X)
    task.wait(0.15)
    pressKey(Enum.KeyCode.Z)
end

