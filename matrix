-- NAVEGACIÓN ENTRE PESTAÑAS
-- ============================================================
local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

local function closeSubFrames()
	for _, frame in ipairs({combatFrame, soruFrame, appearanceFrame, miscFrame}) do
		if frame.Visible then
			local t = TweenService:Create(frame, tweenInfo, {Position = UDim2.new(0, -220, 0, 10)})
			t:Play()
			t.Completed:Connect(function() frame.Visible = false end)
		end
	end
end

toggleBtn.MouseButton1Click:Connect(function()
	if not mainFrame.Visible then
		mainFrame.Visible = true
		TweenService:Create(mainFrame, tweenInfo, {Position = UDim2.new(0, 10, 0, 10)}):Play()
	else
		closeSubFrames()
		local t = TweenService:Create(mainFrame, tweenInfo, {Position = UDim2.new(0, -200, 0, 10)})
		t:Play()
		t.Completed:Connect(function() mainFrame.Visible = false end)
	end
end)

